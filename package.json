{
  "name": "axiom",
  "version": "0.3.1-alpha.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "release:clean": "node scripts/clean.mjs",
    "release:pack": "node scripts/pack.mjs",
    "release:verify": "node scripts/verify-packages.mjs",
    "release:consumer-test": "node scripts/consumer-test.mjs",
    "release:prepare": "npm run release:clean && npm run build && npm test && npm run release:pack && npm run release:verify && npm run release:consumer-test",
    "release:publish": "node scripts/publish.mjs",
    "release:publish:dry-run": "node scripts/publish.mjs --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "author": "AskTech AS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynodia/axiom.git"
  },
  "homepage": "https://github.com/cynodia/axiom",
  "bugs": {
    "url": "https://github.com/cynodia/axiom/issues"
  }
}
