{
  "name": "axiom",
  "version": "0.15.0-alpha.2",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run docs:sync && npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:soak": "AXIOM_WF_TRIALS=50 AXIOM_WF_MIXED_TRIALS=25 AXIOM_AUTHZ_TRIALS=25 npm test --workspaces --if-present",
    "test:browser": "node scripts/browser-test.mjs",
    "release:clean": "node scripts/clean.mjs",
    "release:pack": "npm run docs:sync && node scripts/pack.mjs",
    "release:verify": "node scripts/verify-packages.mjs",
    "release:consumer-test": "node scripts/consumer-test.mjs",
    "release:probe": "node scripts/discoverability-probe.mjs",
    "release:prepare": "npm run release:clean && npm run build && npm run test:soak && npm run test:browser && npm run release:pack && npm run release:verify && npm run release:probe && npm run release:consumer-test",
    "release:publish": "node scripts/publish.mjs",
    "release:dist-tag": "node scripts/dist-tag.mjs",
    "release:dist-tag:dry-run": "node scripts/dist-tag.mjs --dry-run",
    "release:publish:dry-run": "node scripts/publish.mjs --dry-run",
    "docs:sync": "node scripts/sync-docs.mjs",
    "conformance:generate": "node scripts/conformance.mjs && node scripts/query-conformance.mjs && node scripts/migration-conformance.mjs && node scripts/live-query-conformance.mjs && node scripts/workflow-conformance.mjs && node scripts/authorization-conformance.mjs",
    "conformance:run": "node scripts/run-conformance.mjs",
    "schema:generate": "node scripts/schema.mjs",
    "toolkit:metrics": "node scripts/toolkit-metrics.mjs",
    "toolkit:catalog": "node scripts/pattern-catalog.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "author": "AskTech AS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynodia/axiom.git"
  },
  "homepage": "https://github.com/cynodia/axiom",
  "bugs": {
    "url": "https://github.com/cynodia/axiom/issues"
  }
}
