{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@cynodia/axiom": [
        "packages/axiom/src/index.ts"
      ],
      "@cynodia/axiom-core": [
        "packages/core/src/index.ts"
      ],
      "@cynodia/axiom-ui-toolkit": [
        "packages/ui-toolkit/src/index.ts"
      ],
      "@cynodia/axiom-ui-toolkit/research": [
        "packages/ui-toolkit/src/research/index.ts"
      ],
      "@cynodia/axiom-runtime": [
        "packages/runtime/src/index.ts"
      ],
      "@cynodia/axiom-server": [
        "packages/server/src/index.ts"
      ],
      "@cynodia/axiom-compiler": [
        "packages/compiler/src/index.ts"
      ],
      "@cynodia/axiom-agent-api": [
        "packages/agent-api/src/index.ts"
      ],
      "@cynodia/axiom-cli": [
        "packages/cli/src/index.ts"
      ],
      "@cynodia/axiom-demo": [
        "packages/demo/src/index.ts"
      ],
      "@cynodia/axiom-demo/issue-tracker": [
        "packages/demo/src/issue-tracker.ts"
      ],
      "@cynodia/axiom-demo/inventory": [
        "packages/demo/src/inventory.ts"
      ],
      "@cynodia/axiom-demo/order-system": [
        "packages/demo/src/order-system.ts"
      ]
    },
    "declarationMap": true
  }
}
