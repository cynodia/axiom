{
  "name": "@axiom/demo",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./issue-tracker": {
      "types": "./dist/issue-tracker.d.ts",
      "default": "./dist/issue-tracker.js"
    },
    "./inventory": {
      "types": "./dist/inventory.d.ts",
      "default": "./dist/inventory.js"
    }
  },
  "dependencies": {
    "@axiom/compiler": "file:../compiler",
    "@axiom/core": "file:../core",
    "@axiom/runtime": "file:../runtime",
    "@axiom/agent-api": "file:../agent-api"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json tsconfig.test.json && node dist/index.js",
    "test": "node --test dist/test/**/*.test.js"
  }
}
