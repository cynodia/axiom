{
  "name": "@cynodia/axiom-demo",
  "version": "0.16.0-alpha.1",
  "description": "Example Axiom applications used to test domain independence.",
  "license": "MIT",
  "author": "AskTech AS",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynodia/axiom.git"
  },
  "homepage": "https://github.com/cynodia/axiom",
  "bugs": {
    "url": "https://github.com/cynodia/axiom/issues"
  },
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./issue-tracker": {
      "types": "./dist/issue-tracker.d.ts",
      "import": "./dist/issue-tracker.js"
    },
    "./inventory": {
      "types": "./dist/inventory.d.ts",
      "import": "./dist/inventory.js"
    },
    "./order-system": {
      "types": "./dist/order-system.d.ts",
      "import": "./dist/order-system.js"
    },
    "./minimal": {
      "types": "./dist/minimal.d.ts",
      "import": "./dist/minimal.js"
    },
    "./minimal-server": {
      "types": "./dist/minimal-server.d.ts",
      "import": "./dist/minimal-server.js"
    },
    "./order-server": {
      "types": "./dist/order-server.d.ts",
      "import": "./dist/order-server.js"
    },
    "./device-monitor": {
      "types": "./dist/device-monitor.d.ts",
      "import": "./dist/device-monitor.js"
    }
  },
  "dependencies": {
    "@cynodia/axiom": "0.16.0-alpha.1",
    "@cynodia/axiom-agent-api": "0.16.0-alpha.1",
    "@cynodia/axiom-compiler": "0.16.0-alpha.1",
    "@cynodia/axiom-core": "0.16.0-alpha.1",
    "@cynodia/axiom-runtime": "0.16.0-alpha.1",
    "@cynodia/axiom-server": "0.16.0-alpha.1"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json tsconfig.test.json && node dist/index.js",
    "test": "node --test --test-concurrency=1 dist-test/**/*.test.js"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
