  "description": "Application Graph, semantic types, locations and validation for Axiom.",
  "license": "MIT",
  "author": "AskTech AS",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynodia/axiom.git"
  },
