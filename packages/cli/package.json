{
  "name": "@cynodia/axiom-cli",
  "version": "1.0.0-rc.1",
  "description": "Command line tools for inspecting, validating and serving Axiom applications.",
  "license": "MIT",
  "author": "AskTech AS",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynodia/axiom.git"
  },
  "homepage": "https://github.com/cynodia/axiom",
  "bugs": {
    "url": "https://github.com/cynodia/axiom/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "axiom": "./dist/index.js"
  },
  "dependencies": {
    "@cynodia/axiom-core": "1.0.0-rc.1",
    "@cynodia/axiom-compiler": "1.0.0-rc.1",
    "@cynodia/axiom-server": "1.0.0-rc.1",
    "@cynodia/axiom-agent-api": "1.0.0-rc.1"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json tsconfig.test.json",
    "test": "node --test dist-test/**/*.test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
