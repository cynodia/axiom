{
  "conformance": "axiom.conformance.v8",
  "name": "workflow-action-retry",
  "covers": [
    "action",
    "retry"
  ],
  "description": "A retryable failure backs off and the durable attempt count is not reset.",
  "workflowId": "wf_retry",
  "actionOutcomes": {
    "action_do": {
      "ok": false,
      "retryable": true
    }
  },
  "steps": [
    {
      "do": "advance-clock",
      "seconds": 2
    },
    {
      "do": "poll"
    },
    {
      "do": "action-outcome",
      "action": "action_do",
      "ok": true
    },
    {
      "do": "advance-clock",
      "seconds": 5
    },
    {
      "do": "poll"
    }
  ],
  "expectHistory": [
    "started",
    "step-activated",
    "retry-scheduled",
    "step-activated",
    "retry-scheduled",
    "step-activated",
    "step-succeeded",
    "completed"
  ],
  "expectStatus": "completed",
  "serverIR": {
    "contract": "axiom.server.v8",
    "id": "workflow-conformance",
    "name": "Workflow Conformance",
    "version": "0.14.0-alpha.3",
    "entities": [
      {
        "id": "entity_pay",
        "kind": "entity",
        "fields": [
          {
            "id": "field_pay_key",
            "valueType": {
              "kind": "primitive",
              "primitive": "string"
            },
            "required": true
          }
        ]
      }
    ],
    "fields": {
      "field_pay_key": {
        "entityId": "entity_pay",
        "field": {
          "id": "field_pay_key",
          "valueType": {
            "kind": "primitive",
            "primitive": "string"
          },
          "required": true
        }
      }
    },
    "states": [],
    "actions": {},
    "constraints": [],
    "transitionConstraints": [],
    "observableStateIds": [],
    "events": [
      {
        "id": "event_go",
        "kind": "event",
        "payloadType": {
          "kind": "entity",
          "entityId": "entity_pay"
        }
      }
    ],
    "workflows": [
      {
        "id": "wf_start_complete",
        "kind": "workflow",
        "entry": "c",
        "steps": [
          {
            "type": "complete",
            "id": "c"
          }
        ]
      },
      {
        "id": "wf_action",
        "kind": "workflow",
        "entry": "a",
        "steps": [
          {
            "type": "action",
            "id": "a",
            "action": "action_do",
            "arguments": {},
            "next": "done",
            "onError": "recover"
          },
          {
            "type": "action",
            "id": "recover",
            "action": "action_alt",
            "arguments": {},
            "next": "done"
          },
          {
            "type": "complete",
            "id": "done"
          }
        ]
      },
      {
        "id": "wf_action_fail",
        "kind": "workflow",
        "entry": "a",
        "steps": [
          {
            "type": "action",
            "id": "a",
            "action": "action_do",
            "arguments": {},
            "next": "done"
          },
          {
            "type": "complete",
            "id": "done"
          }
        ]
      },
      {
        "id": "wf_retry",
        "kind": "workflow",
        "entry": "a",
        "steps": [
          {
            "type": "action",
            "id": "a",
            "action": "action_do",
            "arguments": {},
            "next": "done",
            "retry": {
              "maxAttempts": 5,
              "initialDelaySeconds": 1,
              "backoffMultiplier": 2,
              "maxDelaySeconds": 30
            }
          },
          {
            "type": "complete",
            "id": "done"
          }
        ]
      },
      {
        "id": "wf_timer",
        "kind": "workflow",
        "entry": "t",
        "steps": [
          {
            "type": "timer",
            "id": "t",
            "after": {
              "seconds": 3600
            },
            "next": "done"
          },
          {
            "type": "complete",
            "id": "done"
          }
        ]
      },
      {
        "id": "wf_event",
        "kind": "workflow",
        "inputs": [
          {
            "id": "input_key",
            "valueType": {
              "kind": "primitive",
              "primitive": "string"
            },
            "required": true
          }
        ],
        "entry": "w",
        "steps": [
          {
            "type": "wait-event",
            "id": "w",
            "event": "event_go",
            "where": {
              "kind": "binary",
              "operator": "eq",
              "left": {
                "kind": "field",
                "source": {
                  "kind": "ref",
                  "targetId": "EVENT"
                },
                "fieldId": "field_pay_key"
              },
              "right": {
                "kind": "ref",
                "targetId": "input_key"
              }
            },
            "next": "done",
            "timeout": {
              "seconds": 7200
            },
            "onTimeout": "gaveup"
          },
          {
            "type": "complete",
            "id": "done"
          },
          {
            "type": "fail",
            "id": "gaveup",
            "error": {
              "reason": {
                "kind": "literal",
                "value": "timeout"
              }
            }
          }
        ]
      },
      {
        "id": "wf_branch",
        "kind": "workflow",
        "inputs": [
          {
            "id": "input_flag",
            "valueType": {
              "kind": "primitive",
              "primitive": "boolean"
            },
            "required": true
          }
        ],
        "entry": "b",
        "steps": [
          {
            "type": "branch",
            "id": "b",
            "when": {
              "kind": "ref",
              "targetId": "input_flag"
            },
            "then": "yes",
            "else": "no"
          },
          {
            "type": "complete",
            "id": "yes"
          },
          {
            "type": "fail",
            "id": "no",
            "error": {
              "reason": {
                "kind": "literal",
                "value": "flag-false"
              }
            }
          }
        ]
      }
    ]
  }
}
