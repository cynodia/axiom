                  }
                }
              },
              "fieldId": "field_io_device_log"
            },
            "value": {
              "kind": "literal",
              "value": null
            }
          },
          {
            "kind": "blob-delete",
            "storageId": "storage_io_logs",
            "blobKey": {
              "kind": "field",
              "source": {
                "kind": "ref",
                "targetId": "scope_io_metadata"
              },
              "fieldId": "field_blob_key"
            }
          }
        ],
        "preconditions": [],
        "failureModes": []
      }
    },
    "constraints": [
      {
        "id": "constraint_io_status",
        "kind": "constraint",
        "entityId": "entity_io_device",
        "message": "Device status must be unknown, online or offline.",
        "expression": {
          "kind": "call",
          "function": "one-of",
          "arguments": [
            {
              "kind": "field",
              "source": {
                "kind": "ref",
                "targetId": "entity_io_device"
              },
              "fieldId": "field_io_device_status"
            },
            {
              "kind": "literal",
              "value": "unknown"
            },
            {
              "kind": "literal",
              "value": "online"
            },
            {
              "kind": "literal",
              "value": "offline"
            }
          ]
        }
      }
    ],
    "transitionConstraints": [],
    "principalEntityId": "entity_io_user",
    "observableStateIds": [
      "state_io_devices"
    ],
    "integrations": [
      {
        "id": "integration_io_devices",
        "kind": "integration",
        "name": "Devices"
      }
    ],
    "events": [
      {
        "id": "event_io_status",
        "kind": "event",
        "payloadType": {
          "kind": "entity",
          "entityId": "entity_io_change"
        }
      }
    ],
    "triggers": [
      {
        "id": "trigger_io_status",
        "kind": "trigger",
        "actionId": "action_io_apply_status",
        "when": {
          "kind": "event",
          "eventId": "event_io_status"
        },
        "arguments": {
          "param_io_device": {
            "kind": "field",
            "source": {
              "kind": "ref",
              "targetId": "trigger_io_status"
            },
            "fieldId": "field_io_change_device"
          },
          "param_io_status": {
            "kind": "field",
            "source": {
              "kind": "ref",
              "targetId": "trigger_io_status"
            },
            "fieldId": "field_io_change_status"
          }
        }
      }
    ],
    "subscriptions": [
      {
        "id": "subscription_io_status",
        "kind": "subscription",
        "name": "live status",
        "integrationId": "integration_io_devices",
        "source": "device-status",
        "eventId": "event_io_status",
        "lifecycle": {
          "reconnect": {
            "policy": "fixed",
            "maxAttempts": 3,
            "delayMs": 100
          }
        },
        "delivery": {
          "deduplicateBy": "field_io_change_delivery",
          "maxQueued": 8,
          "backpressure": "block"
        }
      }
    ],
    "storages": [
      {
        "id": "storage_io_logs",
        "kind": "storage",
        "name": "Logs",
        "blobEntityId": "entity_io_blob",
        "readAuthorization": {
          "kind": "some",
          "source": {
            "kind": "ref",
            "targetId": "state_io_devices"
          },
          "scopeId": "scope_io_ref",
          "predicate": {
            "kind": "binary",
            "operator": "eq",
            "left": {
              "kind": "field",
              "source": {
                "kind": "field",
                "source": {
                  "kind": "ref",
                  "targetId": "scope_io_ref"
                },
                "fieldId": "field_io_device_log"
              },
              "fieldId": "field_blob_key"
            },
            "right": {
              "kind": "field",
              "source": {
                "kind": "ref",
                "targetId": "storage_io_logs"
              },
              "fieldId": "field_blob_key"
            }
          }
        },
        "uploadAuthorization": {
          "kind": "binary",
          "operator": "eq",
          "left": {
            "kind": "field",
            "source": {
              "kind": "ref",
              "targetId": "axiom_principal"
            },
            "fieldId": "field_io_user_role"
          },
          "right": {
            "kind": "literal",
            "value": "operator"
          }
        }
      }
    ]
  },
  "initialState": [
    {
      "stateId": "state_io_devices",
      "value": [
        {
          "field_io_device_id": "d1",
          "field_io_device_status": "unknown",
          "field_io_device_log": null
        }
      ],
      "revision": 1
    }
  ],
  "externalSubscriptions": {
    "subscription_io_status": {
      "entries": [
        {
          "kind": "deliver",
          "afterMs": 1,
          "payload": {
            "field_io_change_device": "d1",
            "field_io_change_status": "melted",
            "field_io_change_delivery": "m-1"
          }
        }
      ]
    }
  },
  "steps": [
    {
      "kind": "advance",
      "ms": 5
    },
    {
      "kind": "expect-subscription",
      "subscriptionId": "subscription_io_status",
      "expect": {
        "state": "active",
        "applied": 0,
        "failed": 1
      }
    }
  ],
  "expectedState": {
    "state_io_devices": [
      {
        "field_io_device_id": "d1",
        "field_io_device_status": "unknown",
        "field_io_device_log": null
      }
    ]
  }
}
