{
  "conformance": "axiom.conformance.v3",
  "name": "subscription-poison-delivery",
  "covers": [
    "subscriptions",
    "constraints",
    "rollback"
  ],
  "description": "A conforming payload whose action violates an invariant rolls that transaction back and is counted as failed, not applied — and the subscription keeps running under the default report policy.",
