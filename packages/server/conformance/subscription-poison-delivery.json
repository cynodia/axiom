          "itemType": {
            "kind": "entity",
            "entityId": "entity_io_device"
          }
        },
        "initialValue": [
          {
            "field_io_device_id": "d1",
            "field_io_device_status": "unknown",
            "field_io_device_log": null
          }
        ]
      }
    ],
    "actions": {
      "action_io_apply_status": {
        "id": "action_io_apply_status",
        "kind": "action",
        "name": "applyStatus",
        "invocation": {
          "allowedSources": [
            "system"
          ]
        },
        "parameters": [
