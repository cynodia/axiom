      "action_io_attach": {
        "id": "action_io_attach",
        "kind": "action",
        "name": "attachLog",
        "authorization": {
          "kind": "binary",
          "operator": "eq",
          "left": {
            "kind": "field",
            "source": {
              "kind": "ref",
              "targetId": "axiom_principal"
            },
            "fieldId": "field_io_user_role"
          },
          "right": {
            "kind": "literal",
            "value": "operator"
          }
        },
        "parameters": [
          {
            "id": "param_io_attach_device",
            "valueType": {
              "kind": "primitive",
              "primitive": "string"
            },
            "required": true
          },
          {
            "id": "param_io_attach_blob",
            "valueType": {
              "kind": "entity",
              "entityId": "entity_io_blob"
            },
            "required": true
          }
        ],
        "operations": [
          {
            "kind": "set",
            "target": {
              "kind": "field",
              "target": {
                "kind": "collection-item",
                "collection": {
                  "kind": "state",
                  "stateId": "state_io_devices"
                },
                "selector": {
                  "kind": "identity",
                  "fieldId": "field_io_device_id",
                  "value": {
                    "kind": "ref",
                    "targetId": "param_io_attach_device"
                  }
                }
              },
              "fieldId": "field_io_device_log"
            },
            "value": {
              "kind": "ref",
              "targetId": "param_io_attach_blob"
            }
          },
          {
            "kind": "blob-commit",
            "storageId": "storage_io_logs",
            "blobKey": {
              "kind": "field",
              "source": {
                "kind": "ref",
                "targetId": "param_io_attach_blob"
              },
              "fieldId": "field_blob_key"
            }
          }
        ],
        "preconditions": [],
        "failureModes": []
      },
      "action_io_detach": {
        "id": "action_io_detach",
        "kind": "action",
        "name": "detachLog",
        "authorization": {
          "kind": "binary",
          "operator": "eq",
          "left": {
            "kind": "field",
            "source": {
              "kind": "ref",
              "targetId": "axiom_principal"
            },
            "fieldId": "field_io_user_role"
          },
          "right": {
            "kind": "literal",
            "value": "operator"
          }
        },
        "parameters": [
          {
            "id": "param_io_detach_device",
            "valueType": {
              "kind": "primitive",
              "primitive": "string"
            },
            "required": true
          }
        ],
        "operations": [
          {
            "kind": "blob-metadata",
            "storageId": "storage_io_logs",
            "bindAs": "scope_io_metadata",
            "blobKey": {
              "kind": "field",
              "source": {
                "kind": "field",
                "source": {
                  "kind": "find",
                  "source": {
                    "kind": "ref",
                    "targetId": "state_io_devices"
                  },
                  "scopeId": "scope_io_device",
                  "predicate": {
                    "kind": "binary",
                    "operator": "eq",
                    "left": {
                      "kind": "field",
                      "source": {
                        "kind": "ref",
                        "targetId": "scope_io_device"
                      },
                      "fieldId": "field_io_device_id"
                    },
                    "right": {
                      "kind": "ref",
                      "targetId": "param_io_detach_device"
                    }
                  }
                },
                "fieldId": "field_io_device_log"
              },
              "fieldId": "field_blob_key"
            }
          },
          {
            "kind": "set",
            "target": {
              "kind": "field",
              "target": {
                "kind": "collection-item",
                "collection": {
                  "kind": "state",
                  "stateId": "state_io_devices"
                },
                "selector": {
                  "kind": "identity",
                  "fieldId": "field_io_device_id",
                  "value": {
                    "kind": "ref",
