        }
      },
      "required": [
        "entityId",
        "field"
      ],
      "additionalProperties": false
    },
    "EntityDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "entity"
        },
        "name": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldDef"
          }
        },
        "identityFieldId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "fields"
      ],
