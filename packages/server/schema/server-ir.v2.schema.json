{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cynodia.github.io/axiom/schema/server-ir.v2.schema.json",
  "title": "Axiom Server IR v2",
  "description": "The normative structure of an `axiom.server.v2` document. Structure only: what a conforming runtime must *do* with it is the semantic contract, and the conformance fixtures are the executable statement of that.",
  "contract": "axiom.server.v2",
  "release": "0.14.0-alpha.5",
  "type": "object",
  "required": [
    "contract",
    "id",
    "name",
    "version",
    "entities",
    "fields",
    "states",
    "actions",
    "constraints",
    "transitionConstraints",
    "observableStateIds"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "axiom.server.v2"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EntityDef"
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/FieldIndexEntry"
      }
    },
    "states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StateDef"
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ActionDef"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConstraintDef"
      }
    },
    "transitionConstraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TransitionConstraintDef"
      }
    },
    "principalEntityId": {
      "type": "string",
      "minLength": 1
    },
    "observableStateIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expressionDefs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ExpressionDef"
      }
    }
  },
  "$defs": {
    "NodeId": {
      "type": "string",
      "minLength": 1
    },
    "FieldId": {
      "type": "string",
      "minLength": 1
    },
    "LiteralValue": {
      "description": "Portable data. No undefined, NaN, Infinity, date object or class instance.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LiteralValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/LiteralValue"
          }
        }
      ]
    },
    "TypeRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "primitive"
            },
            "primitive": {
              "enum": [
                "string",
                "number",
                "boolean",
                "date",
                "datetime",
                "binary"
              ]
            }
          },
          "required": [
            "kind",
            "primitive"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "entity"
            },
            "entityId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "entityId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "collection"
            },
            "itemType": {
              "$ref": "#/$defs/TypeRef"
            }
          },
          "required": [
            "kind",
            "itemType"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "optional"
            },
            "valueType": {
              "$ref": "#/$defs/TypeRef"
            }
          },
          "required": [
            "kind",
            "valueType"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "group"
            },
            "keyType": {
              "$ref": "#/$defs/TypeRef"
            },
            "itemType": {
              "$ref": "#/$defs/TypeRef"
            }
          },
          "required": [
            "kind",
            "keyType",
            "itemType"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Expression": {
      "description": "Every expression kind: literal, ref, field, object, binary, unary, call, filter, find, map, sort, every, some, flatten, conditional, group, expression-ref.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "$ref": "#/$defs/LiteralValue"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ref"
            },
            "targetId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "targetId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "field"
            },
            "source": {
              "$ref": "#/$defs/Expression"
            },
            "fieldId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "source",
            "fieldId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "object"
            },
            "entityId": {
              "type": "string",
              "minLength": 1
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ObjectEntry"
              }
            }
          },
          "required": [
            "kind",
            "entries"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "binary"
            },
            "operator": {
              "enum": [
                "eq",
                "neq",
                "gt",
                "gte",
                "lt",
                "lte",
                "and",
                "or",
                "add",
                "subtract",
                "multiply",
                "divide"
              ]
            },
            "left": {
              "$ref": "#/$defs/Expression"
            },
            "right": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "kind",
            "operator",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unary"
            },
            "operator": {
              "enum": [
                "not",
                "negate"
              ]
            },
            "operand": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "kind",
            "operator",
            "operand"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "call"
            },
            "function": {
              "enum": [
                "required",
                "is-empty",
                "non-empty",
                "length",
                "contains",
                "concat",
                "coalesce",
                "one-of",
                "count",
                "sum",
                "lowercase",
                "to-string",
                "now",
                "uuid"
              ]
            },
            "arguments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              }
            }
          },
          "required": [
            "kind",
            "function",
            "arguments"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "filter"
            },
            "source": {
              "$ref": "#/$defs/Expression"
            },
            "scopeId": {
              "type": "string",
              "minLength": 1
            },
            "predicate": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "kind",
            "source",
            "scopeId",
            "predicate"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "find"
            },
            "source": {
              "$ref": "#/$defs/Expression"
            },
            "scopeId": {
              "type": "string",
              "minLength": 1
            },
            "predicate": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "kind",
            "source",
            "scopeId",
            "predicate"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "map"
            },
            "source": {
              "$ref": "#/$defs/Expression"
            },
            "scopeId": {
              "type": "string",
              "minLength": 1
            },
            "projection": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "kind",
            "source",
            "scopeId",
            "projection"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sort"
            },
            "source": {
              "$ref": "#/$defs/Expression"
            },
            "scopeId": {
              "type": "string",
              "minLength": 1
            },
            "by": {
              "$ref": "#/$defs/Expression"
            },
            "direction": {
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          "required": [
            "kind",
            "source",
            "scopeId",
            "by"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "every"
            },
            "source": {
              "$ref": "#/$defs/Expression"
            },
            "scopeId": {
              "type": "string",
              "minLength": 1
            },
            "predicate": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "kind",
            "source",
            "scopeId",
            "predicate"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "some"
            },
            "source": {
              "$ref": "#/$defs/Expression"
            },
            "scopeId": {
              "type": "string",
              "minLength": 1
            },
            "predicate": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "kind",
            "source",
            "scopeId",
            "predicate"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "flatten"
