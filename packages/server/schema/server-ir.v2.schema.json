            "condition": {
              "$ref": "#/$defs/Expression"
            },
            "whenTrue": {
              "$ref": "#/$defs/Expression"
            },
            "whenFalse": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "kind",
            "condition",
            "whenTrue",
            "whenFalse"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "group"
            },
            "source": {
              "$ref": "#/$defs/Expression"
            },
            "scopeId": {
              "type": "string",
              "minLength": 1
            },
            "by": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "kind",
            "source",
            "scopeId",
            "by"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
